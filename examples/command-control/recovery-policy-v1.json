{
  "schema_version": 1,
  "policy_id": "example-project-recovery-v1",
  "project_id": "example-project",
  "actions": [
    {
      "action_id": "probe_context",
      "authority": "L1",
      "dispatch_kind": "deterministic",
      "handler": "read_only_probe",
      "allowed_command_types": [
        "monitor.probe.requested"
      ],
      "constraints": [
        "read-only filesystem metadata only"
      ],
      "completion_criteria": [
        "context reference metadata is recorded"
      ],
      "enabled": true
    },
    {
      "action_id": "troubleshoot_known_failure",
      "authority": "L2",
      "dispatch_kind": "child_agent",
      "agent_profile": "bounded-troubleshooter",
      "allowed_command_types": [
        "agent.troubleshoot.request"
      ],
      "constraints": [
        "read project governance first",
        "do not change scientific method",
        "do not create new project scope",
        "escalate unresolved uncertainty to L3"
      ],
      "completion_criteria": [
        "evidence and analysis are recorded",
        "bounded action is queued or L3 escalation is emitted"
      ],
      "enabled": true
    }
  ]
}
