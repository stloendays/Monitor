{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stloendays/Monitor/hub/hub_status.schema.json",
  "title": "hub_status.json — status file written by a monitor, read by the monitor hub (adapter \"generic\")",
  "type": "object",
  "required": [
    "updated",
    "headline",
    "table"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "description": "ISO 8601 local time of this monitoring round, e.g. 2026-09-28T21:45:00"
    },
    "headline": {
      "type": "string",
      "description": "One-sentence conclusion in Chinese, e.g. 所有作业正常运行，无需操作。"
    },
    "summary": {
      "type": "string",
      "description": "Short counts; empty = the hub counts the tags (完成 n，运行 n，排队 n，异常 n)"
    },
    "done": {
      "type": "boolean",
      "default": false,
      "description": "true when every planned job is finished and the final results are written"
    },
    "table": {
      "type": "object",
      "required": [
        "cols",
        "rows"
      ],
      "properties": {
        "cols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "tags": {
          "type": "array",
          "description": "One per row: done / run / queue / bad / other (not managed by this monitor) / empty",
          "items": {
            "enum": [
              "done",
              "run",
              "queue",
              "bad",
              "other",
              ""
            ]
          }
        },
        "row_meta": {
          "type": "array",
          "description": "Optional metadata aligned with rows. row_meta[i] describes rows[i] and enables drill-down/open-task behavior.",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string"
              },
              "job_id": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "host": {
                "type": "string"
              },
              "open_path": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "workdir": {
                "type": "string"
              },
              "log": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "script": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Only decisions the user must make, in plain Chinese"
    },
    "working": {
      "type": "string",
      "description": "What the background Claude takeover is doing right now, if anything"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quota, queue reasons and other remarks"
    },
    "next": {
      "type": "string",
      "description": "ISO time of the next round (ignored for scheduled tasks: the scheduler knows)"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "description": "Final deliverables, listed on the 最终结果 page"
    },
    "error": {
      "type": "string",
      "description": "Failure of the monitor itself (e.g. ssh unreachable); not a compute failure"
    }
  }
}
